---
import { profile } from '../data/profile';
const { summary, highlights } = profile;
---

<section class="section" id="about" aria-label="Summary">
  <div class="shell">
    <p class="section__label">Profile</p>

    <div class="highlights__grid">
      <div class="prose highlights__summary reveal">
        {summary.map((p) => <p>{p}</p>)}
      </div>

      <ul class="metrics reveal" style="--reveal-delay: 120ms">
        {
          highlights.map((h) => (
            <li class="metric">
              <span class="metric__value">{h.value}</span>
              <span class="metric__unit">{h.unit}</span>
              <span class="metric__label">{h.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .highlights__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .highlights__summary p {
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .highlights__summary strong {
    color: var(--ink);
  }

  .metrics {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .metric {
    background: var(--surface);
    padding: clamp(1.1rem, 3vw, 1.6rem);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    transition: background 0.2s ease;
  }
  .metric:hover {
    background: var(--bg-tint);
  }
  .metric__value {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1;
    color: var(--accent);
    letter-spacing: -0.02em;
  }
  .metric__unit {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink);
    text-transform: lowercase;
  }
  .metric__label {
    font-size: var(--step--1);
    color: var(--ink-faint);
    margin-top: 0.3rem;
  }

  @media (max-width: 760px) {
    .highlights__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
