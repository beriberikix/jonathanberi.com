---
import { profile } from '../data/profile';
const { name, tagline, links } = profile;
const year = new Date().getFullYear();
---

<footer class="footer" id="contact">
  <div class="shell footer__inner">
    <div class="footer__lead reveal">
      <h2 class="footer__cta">Let’s build something at the edge.</h2>
      <a class="footer__cta-link" href={links.linkedin} target="_blank" rel="noopener"
        >Connect on LinkedIn →</a
      >
    </div>

    <ul class="footer__links" aria-label="Social profiles">
      <li><a href={links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></li>
      <li><a href={links.github} target="_blank" rel="noopener">GitHub ↗</a></li>
      <li><a href={links.bluesky} target="_blank" rel="noopener">Bluesky ↗</a></li>
    </ul>

    <div class="footer__base">
      <span>© {year} {name}</span>
      <span class="footer__tag">{tagline}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-tint);
    border-top: 1px solid var(--line);
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(2rem, 4vw, 3rem);
  }
  .footer__lead {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .footer__cta {
    font-size: var(--step-3);
    letter-spacing: -0.02em;
    max-width: 16ch;
  }
  .footer__cta-link {
    font-family: var(--font-mono);
    font-size: var(--step-1);
    color: var(--accent);
    width: fit-content;
    box-shadow: inset 0 -2px 0 var(--accent-soft);
    transition: box-shadow 0.2s ease;
  }
  .footer__cta-link:hover {
    box-shadow: inset 0 -0.9em 0 var(--accent-soft);
  }

  .footer__links {
    list-style: none;
    padding: 0;
    margin: 0 0 clamp(2.5rem, 6vw, 4rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .footer__links a {
    color: var(--ink-soft);
    transition: color 0.2s ease;
  }
  .footer__links a:hover {
    color: var(--accent);
  }

  .footer__base {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
  .footer__tag {
    font-style: italic;
    font-family: var(--font-display);
  }
</style>
