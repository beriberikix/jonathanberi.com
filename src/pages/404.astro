---
import Base from '../layouts/Base.astro';
---

<Base title="Lost signal · Jonathan Beri" description="Page not found.">
  <main class="nf">
    <div class="shell nf__inner">
      <p class="nf__code">404</p>
      <h1 class="nf__title">Lost signal.</h1>
      <p class="nf__text">That grain of sand never made it to the internet. Let’s get you back.</p>
      <a class="nf__home" href="/">← Back home</a>
    </div>
  </main>
</Base>

<style>
  .nf {
    min-height: 100vh;
    display: grid;
    place-items: center;
    text-align: center;
  }
  .nf__code {
    font-family: var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.3em;
    margin-bottom: 1rem;
  }
  .nf__title {
    font-size: var(--step-4);
    margin-bottom: 1rem;
  }
  .nf__text {
    color: var(--ink-soft);
    max-width: 40ch;
    margin: 0 auto 2rem;
  }
  .nf__home {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0.6rem 1.3rem;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .nf__home:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
